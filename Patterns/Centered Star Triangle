#include <bits/stdc++.h>
using namespace std;

class solution {
public:
    void printCenteredStarTriangle(int n) {
        // Write your code here...
        for (int i =0; i<n; i++){
            for (int j = 0; j<(n-i-1); j++){
                cout << " ";
            }
            for (int k=1 ; k<= (2*i+1); k++){
                cout << "*";
            }
            cout << endl;
        }
    }
};
