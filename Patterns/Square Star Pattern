Qstn ) : Given an integer n, print a square pattern of size n*n using the asterisk ( * ). Each row should contain n stars, separated by and there should be n rows.
if n = 3 , then output should be:-
* * *
* * *
* * *
Ans ) : (in cpp)

#include <bits/stdc++.h>
using namespace std;

class solution {
public:
    void printSquarePattern(int n) {
        // Write your code here...
        for(int j=0; j<n; j++){
            for(int i = 0; i<n ; i++){
                cout << "* ";
            }
        cout << endl;
        }
    }
};
