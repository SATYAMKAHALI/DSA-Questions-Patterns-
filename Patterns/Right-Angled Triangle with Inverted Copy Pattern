#include <bits/stdc++.h>
using namespace std;

class solution {
public:
    void printTrianglePattern(int n) {
        //Write your code here...
        for (int i=0; i<n; i++){
            for (int j=0; j<=i; j++){
                cout << "* ";
            }
            cout << endl;
        }
        for (int k=(n-1); k>0; k--){
            for(int p=0; p<k; p++){
                cout << "* ";
            }
            cout << endl;
        }
    }
};
