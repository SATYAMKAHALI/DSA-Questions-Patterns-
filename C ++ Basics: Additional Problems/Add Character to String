Type 2 - In place Modification :

#include <bits/stdc++.h>
using namespace std;

class solution{
public:
    string addChar(char c, string &s) {      // The & means pass by reference.Instead of making a copy of the string, the function works on the original string.
        s.insert(s.begin(), c);              // Since s is passed by reference, both s in main() and s inside the function refer to the same string.
        s.push_back(c);                      // s. begin () : It returns an iterator pointing to the first character.. s.insert(s.begin(), 'A') will make "Ahello" if String is "hello" and character is "c".
        return s;                            // string.insert(position, character); & s.push_back() adds a character at the end. so it will become "AhelloA".
    }
};

int main() {
    char c;
    string s;
                                              
    cin >> c;                                
    cin.ignore();                            // cin.ignore() is explained in the end.
    getline(cin, s);                         // this is an input getline() function which takes the string as input. It does not take a char variable as input. It takes input and stores it into a string variable s.

    solution sol;
    string result = sol.addChar(c, s);

    cout << result << endl;

    return 0;
}
